{
    "name": "ucpws/ucp-server-for-woocommerce",
    "description": "UCP Server for WooCommerce - turns a WooCommerce shop into a Universal Commerce Protocol (UCP) business server.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "wordpress",
        "woocommerce",
        "ucp",
        "agentic-commerce"
    ],
    "support": {
        "issues": "https://github.com/example/ucp-server-for-woocommerce/issues"
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "opis/json-schema": "^2.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^9.5",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "UCPWS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UCPWS\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "phpcs -p",
        "phpcbf": "phpcbf -p",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test:unit": "phpunit -c phpunit-unit.xml.dist"
    }
}
